-- Example graph: list of pairs (vertex, list of neighbours)
graph = [(1,[2,3]), (2,[4]), (3,[4,5]), (4,[]), (5,[])]

-- lookupGraph: given a graph and a node, return its list of neighbours
lookupGraph g x = case g of
  []               -> []

  ((v,vs):rest)    ->
    if x == v
      then vs
      else lookupGraph rest x

-- elem: test whether x is in xs
elem x xs = case xs of
  []      -> False

  (y:ys)  ->
    if x == y
      then True
      else elem x ys

-- append: concatenate two lists
append xs ys = case xs of
  []      -> ys

  (z:zs)  -> z : append zs ys

-- filterNotVisited: keep only the unvisited neighbours
filterNotVisited xs visited = case xs of
  []      -> []

  (z:zs)  ->
    if elem z visited
      then filterNotVisited zs visited
      else z : filterNotVisited zs visited

-- bfsRec: (queue of nodes) and (list of visited nodes)
bfsRec queue visited = case queue of
  []      -> visited

  (n:ns)  ->
    let nbrs     = lookupGraph graph n in
    let news     = filterNotVisited nbrs visited in
    let queue'   = append ns news in
    let visited' = append visited news in
    bfsRec queue' visited'

-- bfs: start the BFS from a node
bfs start = bfsRec [start] [start]

-- main: run bfs starting from 1
main = bfs 1
