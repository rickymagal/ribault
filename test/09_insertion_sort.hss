-- Insertion sort in our functional language

-- Insert element x into an already sorted list xs
insert x xs = case xs of
  []      -> [x]

  (y:ys)  ->
    if x <= y
      then x : xs
      else y : insert x ys

-- insertionSort: sort the list by applying insert recursively
insertionSort lst = case lst of
  []     -> []

  (h:t)  -> insert h (insertionSort t)

-- Test in main
main = insertionSort [34, 7, 23, 32, 5, 62]
